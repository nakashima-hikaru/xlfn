+    /// Diagnostic control for preseeded, unique-hash topics only. The normal
+    /// prepare path and collision handling do not use this method.
+    #[cfg(all(feature = "bench-internals", feature = "rtd"))]
+    pub(crate) fn benchmark_prepare_existing<S: RtdSource, const COMPARE: bool>(
+        &self,
+        source: &RtdSourceHandle<S>,
+        topic: &RtdTopic,
+    ) -> XllResult<PreparedSubscription<'_, H>> {
+        let _operation = self
+            .services
+            .runtime_gate
+            .enter()
+            .map_err(|_| XllError::Closing)?;
+        if source.id.generation != self.generation {
+            return Err(XllError::StaleHandle);
+        }
+        let mut catalog = self.catalog.lock();
+        let found = if COMPARE {
+            catalog.find_identity(SourceId(source.id), topic)?
+        } else {
+            // The fixture validates singleton buckets and full equality before
+            // timing. Hash-only identity is deliberately invalid for general use.
+            let key = super::topic::SubscriptionIdentityKey::new(SourceId(source.id), topic);
+            catalog
+                .identities
+                .candidates(key)
+                .first()
+                .and_then(|&slot| catalog.entries.get(slot).map(|record| (slot, record)))
+        };
+        let (slot, record) = found.ok_or(XllError::Internal {
+            diagnostic_id: crate::diagnostics::id::DiagnosticId::RTD_INDEX_ORPHAN,
+        })?;
+        let id = record.id;
+        let key = SubscriptionKey::from_internal(self.runtime_id, id);
+        if record.entry.is_connected() {
+            return Ok(PreparedSubscription {
+                id,
+                key,
+                reservation: None,
+            });
+        }
+        catalog
+            .with_slot(slot, SubscriptionEntry::add_reservation)
+            .ok_or(XllError::Internal {
+                diagnostic_id: crate::diagnostics::id::DiagnosticId::RTD_INDEX_ORPHAN,
+            })??;
+        Ok(PreparedSubscription {
+            id,
+            key,
+            reservation: Some(PreparationReservation { runtime: self }),
+        })
+    }
+
     pub(crate) fn finish_preparation(&self, id: SubscriptionId, committed: bool) {
         {
             let mut catalog = self.catalog.lock();

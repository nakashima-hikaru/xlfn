+/// Controlled breakdown of the existing-topic path in the stable-slot candidate.
+#[derive(Clone, Copy, Debug)]
+pub enum RtdExistingBreakdownCase {
+    Production,
+    OwnedCompare,
+    BorrowedCompare,
+    OwnedHashOnly,
+    BorrowedHashOnly,
+    DropOnly,
+    CommitOnly,
+}
+
+impl RtdExistingBreakdownCase {
+    pub const ALL: [Self; 7] = [
+        Self::Production,
+        Self::OwnedCompare,
+        Self::BorrowedCompare,
+        Self::OwnedHashOnly,
+        Self::BorrowedHashOnly,
+        Self::DropOnly,
+        Self::CommitOnly,
+    ];
+
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Production => "production",
+            Self::OwnedCompare => "owned_compare",
+            Self::BorrowedCompare => "borrowed_compare",
+            Self::OwnedHashOnly => "owned_hash_only",
+            Self::BorrowedHashOnly => "borrowed_hash_only",
+            Self::DropOnly => "drop_only",
+            Self::CommitOnly => "commit_only",
+        }
+    }
+}
+
+pub struct RtdExistingBreakdownBenchmark {
+    fixture: RtdPrepareBenchmark,
+    ids: Vec<crate::subscription::SubscriptionId>,
+}
+
+impl RtdExistingBreakdownBenchmark {
+    pub fn new(count: usize, parts: usize, case: RtdExistingBreakdownCase) -> Self {
+        let fixture = RtdPrepareBenchmark::new(count, parts, true);
+        let ids = {
+            let mut catalog = fixture.runtime.catalog.lock();
+            let ids: Vec<_> = fixture
+                .topics
+                .iter()
+                .map(|topic| {
+                    let source_id = crate::subscription::SourceId(fixture.source.id);
+                    let key = crate::subscription::SubscriptionIdentityKey::new(source_id, topic);
+                    let candidates = catalog.identities.candidates(key);
+                    assert_eq!(
+                        candidates.len(),
+                        1,
+                        "hash-only diagnostic requires singleton buckets"
+                    );
+                    let record = catalog.entries.get(candidates[0]).expect("seeded record");
+                    assert_eq!(record.entry.source_id, source_id);
+                    assert_eq!(&record.entry.topic, topic);
+                    record.id
+                })
+                .collect();
+            if matches!(case, RtdExistingBreakdownCase::CommitOnly) {
+                for &id in &ids {
+                    catalog
+                        .with_entry(id, |entry| entry.add_reservation())
+                        .expect("seeded entry")
+                        .expect("seed extra reservation");
+                }
+            }
+            ids
+        };
+        Self { fixture, ids }
+    }
+
+    pub fn run(&mut self, case: RtdExistingBreakdownCase) {
+        match case {
+            RtdExistingBreakdownCase::Production => self.fixture.run_prepare(),
+            RtdExistingBreakdownCase::OwnedCompare => self.owned::<true>(),
+            RtdExistingBreakdownCase::BorrowedCompare => self.borrowed::<true>(),
+            RtdExistingBreakdownCase::OwnedHashOnly => self.owned::<false>(),
+            RtdExistingBreakdownCase::BorrowedHashOnly => self.borrowed::<false>(),
+            RtdExistingBreakdownCase::DropOnly => {
+                for topic in self.fixture.topics.drain(..) {
+                    drop(std::hint::black_box(topic));
+                }
+            }
+            RtdExistingBreakdownCase::CommitOnly => {
+                for &id in &self.ids {
+                    self.fixture
+                        .runtime
+                        .finish_preparation(std::hint::black_box(id), true);
+                }
+            }
+        }
+    }
+
+    fn owned<const COMPARE: bool>(&mut self) {
+        for topic in self.fixture.topics.drain(..) {
+            let prepared = self
+                .fixture
+                .runtime
+                .benchmark_prepare_existing::<_, COMPARE>(&self.fixture.source, &topic)
+                .expect("seeded topic");
+            // Match production: destroy the consumed input after prepare releases
+            // its gate/lock, before reservation commit takes the lock again.
+            drop(topic);
+            std::hint::black_box(prepared.id());
+            prepared.commit();
+        }
+    }
+
+    fn borrowed<const COMPARE: bool>(&self) {
+        for topic in &self.fixture.topics {
+            let prepared = self
+                .fixture
+                .runtime
+                .benchmark_prepare_existing::<_, COMPARE>(
+                    &self.fixture.source,
+                    std::hint::black_box(topic),
+                )
+                .expect("seeded topic");
+            std::hint::black_box(prepared.id());
+            prepared.commit();
+        }
+    }
+}
+
+#[cfg(test)]
+mod existing_breakdown_tests {
+    use super::*;
+
+    #[test]
+    fn controls_preserve_seeded_catalog() {
+        for parts in [1, 10] {
+            for case in RtdExistingBreakdownCase::ALL {
+                let mut bench = RtdExistingBreakdownBenchmark::new(16, parts, case);
+                bench.run(case);
+                let catalog = bench.fixture.runtime.catalog.lock();
+                catalog.assert_identity_invariants();
+                assert_eq!(catalog.entries.len(), 16);
+                for &id in &bench.ids {
+                    let (_, entry) = catalog.get_by_id(id).unwrap();
+                    assert!(!entry.is_active());
+                    assert!(entry.tracks_pending_bytes());
+                }
+            }
         }
     }
 }

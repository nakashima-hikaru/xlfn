+            assert_eq!(runtime.catalog.lock().next_subscription_id, next);
+            assert_eq!(runtime.catalog.lock().pending_topic_bytes, 1);
+            let same = runtime.prepare_parts(&source, ["a"]).unwrap();
+            assert_eq!(same.id(), first.id());
+            same.rollback();
+            first.rollback();
+            runtime.prepare_parts(&source, ["b"]).unwrap().rollback();
+            assert_eq!(runtime.catalog.lock().pending_topic_bytes, 0);
+            let before = runtime.catalog.lock().next_subscription_id;
+            assert!(runtime.prepare_parts(&source, [""]).is_err());
+            assert_eq!(runtime.catalog.lock().next_subscription_id, before);
+            runtime.close().unwrap();
+            assert!(matches!(
+                runtime.prepare_parts(&source, ["a"]),
+                Err(XllError::Closing)
+            ));
+        }
+        let (arena, source, _, _) = publishing_source::<f64>(None);
+        let runtime = Runtime::with_host(
+            RuntimeGeneration::new(2).unwrap(),
+            RtdLimits::standard(),
+            Default::default(),
+            arena,
+        );
+        assert!(matches!(
+            runtime.prepare_parts(&source, ["a"]),
+            Err(XllError::StaleHandle)
+        ));
+        assert!(runtime.catalog.lock().entries.is_empty());
+    }

+            let first = runtime.prepare_parts(&source, ["a"]).unwrap();
+            let next = runtime.catalog.lock().next_subscription_id;
+            assert!(matches!(
+                runtime.prepare_parts(&source, ["b"]),
+                Err(XllError::Overloaded)

+                    })??;
+            }
+            return Ok(PreparedSubscription {
+                id,
+                key: SubscriptionKey::from_internal(self.runtime_id, id),
+                reservation: (!connected).then_some(PreparationReservation { runtime: self }),
+            });
+        }
+        // Only a miss materializes Strings. Validated metadata is moved,
+        // so this does not repeat validation or hashing.
+        let (id, key) =

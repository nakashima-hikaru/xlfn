+    #[test]
+    fn borrowed_miss_owns_input_and_pending_hit_retains_only_canonical_storage() {
+        let (arena, source, _, _) = publishing_source::<f64>(None);
+        let runtime = Runtime::with_sources_for_internal(arena);
+        let first = {
+            let input = String::from("USD\0JPY");

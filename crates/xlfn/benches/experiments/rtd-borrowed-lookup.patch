+            let prepared = runtime.prepare_parts(&source, ["market", &input]).unwrap();
+            let catalog = runtime.catalog.lock();
+            let (_, entry) = catalog.get_by_id(prepared.id()).unwrap();
+            assert_ne!(entry.topic.parts()[1].as_ptr(), caller_ptr);

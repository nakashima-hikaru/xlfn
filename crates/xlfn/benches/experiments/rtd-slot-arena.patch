+/// Catalog-local physical location. Never retained outside the catalog lock.
+#[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)]
+pub(crate) struct SubscriptionSlot {
+    index: u32,
+    generation: u32,
+}
+
+impl SubscriptionSlot {

+        Self { index, generation }
+    }
+}
+
+struct ArenaSlot {
+    generation: u32,
+    record: Option<SubscriptionRecord>,
+}
+
+pub(crate) struct SubscriptionRecord {
+    pub(crate) id: SubscriptionId,
+    pub(crate) entry: SubscriptionEntry,
+}
+
+#[derive(Default)]
+pub(crate) struct SubscriptionArena {
+    slots: Vec<ArenaSlot>,
+    free: Vec<u32>,
+}
+
+impl SubscriptionArena {
+    // Planning does not claim the slot. The catalog lock protects the interval
+    // between this check and commit_insert, including fallible index admission.
+    fn plan_insert(&self) -> XllResult<SubscriptionSlot> {
+        if let Some(&index) = self.free.last() {
+            let storage = &self.slots[index as usize];
+            if storage.record.is_some() {
+                xlfn_kernel::invariant::fail_stop();
+            }
+            Ok(SubscriptionSlot {
+                index,
+                generation: storage.generation,
+            })
+        } else {
+            let index = u32::try_from(self.slots.len()).map_err(|_| XllError::Overloaded)?;
+            Ok(SubscriptionSlot {
+                index,
+                generation: 1,
+            })
+        }
+    }
+
+    fn commit_insert(
+        &mut self,
+        slot: SubscriptionSlot,
+        id: SubscriptionId,
+        entry: SubscriptionEntry,
+    ) {
+        let record = SubscriptionRecord { id, entry };
+        if let Some(index) = self.free.pop() {
+            let storage = &mut self.slots[index as usize];
+            if index != slot.index
+                || storage.generation != slot.generation
+                || storage.record.is_some()
+            {
+                xlfn_kernel::invariant::fail_stop();
+            }
+            storage.record = Some(record);
+        } else {
+            if self.slots.len() != slot.index as usize || slot.generation != 1 {
+                xlfn_kernel::invariant::fail_stop();
+            }
+            self.slots.push(ArenaSlot {
+                generation: 1,
+                record: Some(record),
+            });
+        }
+    }
+
+    pub(crate) fn get(&self, slot: SubscriptionSlot) -> Option<&SubscriptionRecord> {
+        let storage = self.slots.get(slot.index as usize)?;
+        if storage.generation != slot.generation {
+            return None;
+        }
+        storage.record.as_ref()
+    }
+
+    fn get_mut(&mut self, slot: SubscriptionSlot) -> Option<&mut SubscriptionRecord> {
+        let storage = self.slots.get_mut(slot.index as usize)?;
+        if storage.generation != slot.generation {
+            return None;
+        }
+        storage.record.as_mut()
+    }
+
+    fn remove(&mut self, slot: SubscriptionSlot) -> Option<SubscriptionRecord> {
+        let storage = self.slots.get_mut(slot.index as usize)?;
+        if storage.generation != slot.generation {
+            return None;
+        }
+        let record = storage.record.take()?;
+        storage.generation = storage
+            .generation
+            .checked_add(1)
+            .unwrap_or_else(|| xlfn_kernel::invariant::fail_stop());
+        self.free.push(slot.index);
+        Some(record)
+    }
+
+    pub(crate) fn iter(&self) -> impl Iterator<Item = (&SubscriptionId, &SubscriptionEntry)> {
+        self.slots
+            .iter()
+            .filter_map(|slot| slot.record.as_ref())
+            .map(|record| (&record.id, &record.entry))
+    }
+
+    fn values(&self) -> impl Iterator<Item = &SubscriptionEntry> {
+        self.iter().map(|(_, entry)| entry)
+    }
+
+    pub(crate) fn clear(&mut self) {
+        // Keep generations, so a stale token cannot become valid after clear.
+        for (index, storage) in self.slots.iter_mut().enumerate() {
+            if storage.record.take().is_some() {
+                storage.generation = storage
+                    .generation
+                    .checked_add(1)
+                    .unwrap_or_else(|| xlfn_kernel::invariant::fail_stop());
+                self.free.push(index as u32);
+            }
+        }
+    }
+
+    #[cfg(test)]
+    pub(crate) fn len(&self) -> usize {
+        self.slots.len() - self.free.len()
+    }
+
+    #[cfg(test)]
+    pub(crate) fn is_empty(&self) -> bool {
+        self.len() == 0
+    }
+
+    #[cfg(test)]
+    fn assert_invariants(&self) {
+        let mut seen_free = rustc_hash::FxHashSet::default();
+        for &index in &self.free {
+            assert!(seen_free.insert(index));
+            assert!(self.slots[index as usize].record.is_none());
+        }
+        for (index, storage) in self.slots.iter().enumerate() {
+            assert_ne!(storage.generation, 0);
+            assert_eq!(
+                storage.record.is_none(),
+                seen_free.contains(&(index as u32))
+            );
+        }
+    }
+}

+#[cfg(test)]
+mod slot_tests {
+    use super::*;
+    use crate::subscription::RtdCapacity;
+    use crate::subscription::tests::{SourceFixture, publishing_source};
+
+    fn catalog() -> SubscriptionCatalog {
+        SubscriptionCatalog {
+            entries: SubscriptionArena::default(),
+            slot_by_id: FxHashMap::default(),
+            identities: SubscriptionIdentityIndex::default(),
+            pending_topic_bytes: 0,
+            next_subscription_id: 1,
+        }
+    }
+
+    fn insert(
+        catalog: &mut SubscriptionCatalog,
+        source: SourceHandleId,
+        name: &str,
+    ) -> SubscriptionId {
+        catalog
+            .insert_pending(
+                1,
+                source,
+                RtdTopic::single(name).unwrap(),
+                RtdLimits::standard(),
+            )
+            .unwrap()
+            .0
+    }
+
+    #[test]
+    fn reuse_rejects_stale_slots_and_preserves_logical_ids() {
+        let (_arena, source, _, _) = publishing_source::<f64>(None);
+        let mut catalog = catalog();
+        let first = insert(&mut catalog, source.id, "first");
+        let first_slot = catalog.get_by_id(first).unwrap().0;
+        assert!(catalog.remove_entry(first).is_some());
+        assert!(catalog.entries.get(first_slot).is_none());
+        let second = insert(&mut catalog, source.id, "second");
+        let second_slot = catalog.get_by_id(second).unwrap().0;
+        assert_ne!(first, second);
+        assert_eq!(first_slot.index, second_slot.index);
+        assert_eq!(second_slot.generation, first_slot.generation + 1);
+        assert!(catalog.get_by_id(first).is_none());
+        assert!(catalog.entries.get(first_slot).is_none());
+        assert!(catalog.entries.get_mut(first_slot).is_none());
+        assert!(catalog.entries.remove(first_slot).is_none());
+        assert!(
+            catalog
+                .with_slot(first_slot, |_| panic!("stale slot must not be visited"))
+                .is_none()
+        );
+        assert_eq!(catalog.entries.get(second_slot).unwrap().id, second);
+        catalog.assert_identity_invariants();
+    }
+
+    #[test]
+    fn churn_reuses_high_water_slots_with_collisions() {
+        let (_arena, source, _, _) = publishing_source::<f64>(None);
+        let mut catalog = catalog();
+        for round in 0..32 {
+            let mut ids = Vec::new();
+            for item in 0..16 {
+                let topic = RtdTopic::single(format!("{round}-{item}"))
+                    .unwrap()
+                    .with_test_identity_hash(42);
+                ids.push(
+                    catalog
+                        .insert_pending(1, source.id, topic, RtdLimits::standard())
+                        .unwrap()
+                        .0,
+                );
+            }
+            assert_eq!(catalog.entries.slots.len(), 16);
+            assert_eq!(catalog.identities.slots_by_key.len(), 1);
+            catalog.assert_identity_invariants();
+            for id in ids.iter().step_by(2).chain(ids.iter().skip(1).step_by(2)) {
+                catalog.remove_entry(*id).unwrap();
+                catalog.assert_identity_invariants();
+            }
+            assert_eq!(catalog.entries.free.len(), 16);
+            assert_eq!(catalog.pending_topic_bytes, 0);
+        }
+        assert_eq!(catalog.next_subscription_id, 513);
+    }
+
+    #[test]
+    fn failed_admission_does_not_consume_id_or_reserved_slot() {
+        let fixture = SourceFixture::new();
+        let (source_a, _, _) = fixture.add::<f64>(None);
+        let (source_b, _, _) = fixture.add::<f64>(None);
+        let _arena = fixture.finish();
+        let mut catalog = catalog();
+        let _first = insert(&mut catalog, source_a.id, "first");
+        let second = insert(&mut catalog, source_a.id, "second");
+        catalog.remove_entry(second).unwrap();
+        let slot = catalog.entries.plan_insert().unwrap();
+        let id = catalog.next_subscription_id;
+        let bytes = catalog.pending_topic_bytes;
+        let source_limit = RtdLimits {
+            max_source_ids: RtdCapacity::from_usize(1),
+            ..RtdLimits::standard()
+        };
+        let pending_limit = RtdLimits {
+            max_pending: RtdCapacity::from_usize(1),
+            ..RtdLimits::standard()
+        };
+        let byte_limit = RtdLimits {
+            max_total_topic_bytes: RtdCapacity::from_usize(bytes),
+            ..RtdLimits::standard()
+        };
+        for (source, limits) in [
+            (source_b.id, source_limit),
+            (source_a.id, pending_limit),
+            (source_a.id, byte_limit),
+        ] {
+            assert!(matches!(
+                catalog.insert_pending(1, source, RtdTopic::single("blocked").unwrap(), limits),
+                Err(XllError::Overloaded)
+            ));
+            assert_eq!(catalog.entries.plan_insert().unwrap(), slot);
+            assert_eq!(catalog.next_subscription_id, id);
+            assert_eq!(catalog.pending_topic_bytes, bytes);
+            assert_eq!(catalog.entries.slots.len(), 2);
+            assert_eq!(catalog.entries.free.len(), 1);
+            catalog.assert_identity_invariants();
+        }
+        catalog.next_subscription_id = u64::MAX;
+        assert!(matches!(
+            catalog.insert_pending(
+                1,
+                source_a.id,
+                RtdTopic::single("overflow").unwrap(),
+                RtdLimits::standard()
+            ),
+            Err(XllError::Internal {
+                diagnostic_id: crate::diagnostics::id::DiagnosticId::RTD_SUBSCRIPTION_OVERFLOW
+            })
+        ));
+        assert_eq!(catalog.entries.plan_insert().unwrap(), slot);
+        assert_eq!(catalog.pending_topic_bytes, bytes);
+        catalog.next_subscription_id = id;
+        let replacement = insert(&mut catalog, source_a.id, "replacement");
+        assert_eq!(replacement, SubscriptionId(id));
+        assert_eq!(catalog.get_by_id(replacement).unwrap().0, slot);
+        catalog.assert_identity_invariants();
+    }
+
+    #[test]
+    fn clear_invalidates_live_slots_without_duplicating_free_entries() {
+        let (_arena, source, _, _) = publishing_source::<f64>(None);
+        let mut catalog = catalog();
+        let first = insert(&mut catalog, source.id, "first");
+        let second = insert(&mut catalog, source.id, "second");
+        let live_slot = catalog.get_by_id(first).unwrap().0;
+        let removed_slot = catalog.get_by_id(second).unwrap().0;
+        catalog.remove_entry(second).unwrap();
+        catalog.identities.clear();
+        catalog.slot_by_id.clear();
+        catalog.pending_topic_bytes = 0;
+        catalog.entries.clear();
+        catalog.entries.clear();
+        catalog.assert_identity_invariants();
+        assert_eq!(catalog.entries.free.len(), 2);
+        for name in ["replacement-a", "replacement-b"] {
+            insert(&mut catalog, source.id, name);
+        }
+        assert!(catalog.entries.get(live_slot).is_none());
+        assert!(catalog.entries.get(removed_slot).is_none());
+        assert_eq!(catalog.entries.slots.len(), 2);
+        catalog.assert_identity_invariants();
+    }
+
+    #[test]
+    fn stale_identity_candidate_cannot_resolve_to_reused_slot() {
+        let (_arena, source, _, _) = publishing_source::<f64>(None);
+        let mut catalog = catalog();
+        let first = insert(&mut catalog, source.id, "old");
+        let stale = catalog.get_by_id(first).unwrap().0;
+        catalog.remove_entry(first).unwrap();
+        let replacement = insert(&mut catalog, source.id, "new");
+        let old_topic = RtdTopic::single("old").unwrap();
+        let old_key = SubscriptionIdentityKey::new(SourceId(source.id), &old_topic);
+        catalog.identities.insert(old_key, stale, 1).unwrap();
+        assert!(matches!(
+            catalog.find_identity(SourceId(source.id), &old_topic),
+            Err(XllError::Internal {
+                diagnostic_id: crate::diagnostics::id::DiagnosticId::RTD_INDEX_ORPHAN
+            })
+        ));
+        assert!(catalog.identities.remove(old_key, stale));
+        assert!(catalog.get_by_id(replacement).is_some());
+        catalog.assert_identity_invariants();
+    }
+
+    #[test]
+    #[cfg(not(miri))]
+    fn generation_overflow_aborts_instead_of_reusing_a_token() {
+        const CHILD: &str = "XLFN_RTD_SLOT_OVERFLOW_CHILD";
+        if std::env::var_os(CHILD).is_some() {
+            let (_arena, source, _, _) = publishing_source::<f64>(None);
+            let mut catalog = catalog();
+            let id = insert(&mut catalog, source.id, "overflow");
+            let (mut slot, _) = catalog.get_by_id(id).unwrap();
+            catalog.entries.slots[slot.index as usize].generation = u32::MAX;
+            slot.generation = u32::MAX;
+            let _ = catalog.entries.remove(slot);
+            panic!("generation overflow must abort");
+        }
+        let status = std::process::Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", "subscription::catalog::slot_tests::generation_overflow_aborts_instead_of_reusing_a_token"])
+            .env(CHILD, "1")
+            .status().unwrap();
+        assert!(!status.success());
+        assert_ne!(status.code(), Some(101), "a panic is not fail-stop");
+        #[cfg(unix)]
+        {
+            use std::os::unix::process::ExitStatusExt;
+            assert_eq!(status.signal(), Some(6));
+        }
+    }
+}

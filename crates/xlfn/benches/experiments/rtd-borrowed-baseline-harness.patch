+
+/// Caller-owned inputs; validation, hashing and any topic copies are timed.
+pub struct RtdBorrowedBenchmark<const N: usize> {
+    runtime: crate::subscription::SubscriptionRuntime,
+    source: crate::subscription::RtdSourceHandle<BenchmarkRtdSource<f64>>,
+    inputs: Vec<[String; N]>,
+}
+
+impl<const N: usize> RtdBorrowedBenchmark<N> {
+    pub fn new(count: usize, existing: bool) -> Self {
+        let fixture = RtdPrepareBenchmark::new(count, N, existing);
+        Self {
+            runtime: fixture.runtime,
+            source: fixture.source,
+            inputs: (0..count)
+                .map(|index| std::array::from_fn(|part| format!("market-{index:06}-field-{part:02}")))
+                .collect(),
+        }
+    }
+
+    pub fn run<const BORROWED: bool>(&self, churn: bool) {
+        let prepare = |input: &[String; N]| {
+            if BORROWED {
+                self.runtime.prepare_parts(&self.source, std::array::from_fn::<_, N, _>(|i| input[i].as_str()))
+            } else {
+                self.runtime.prepare(&self.source, crate::subscription::RtdTopic::new(input.iter().map(String::as_str)).expect("valid topic"))
+            }.expect("prepare topic")
+        };
+        if churn {
+            let reservations: Vec<_> = self.inputs.iter().map(prepare).collect();
+            for reservation in reservations {
+                std::hint::black_box(reservation.id());
+                reservation.rollback();
+            }
+        } else {
+            for input in &self.inputs {
+                let reservation = prepare(input);
+                std::hint::black_box(reservation.id());
+                reservation.commit();
+            }
         }
     }
 }

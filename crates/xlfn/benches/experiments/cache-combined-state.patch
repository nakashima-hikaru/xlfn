+    #[cfg(not(all(target_os = "windows", target_arch = "x86")))]
+    #[test]
+    fn loom_combined_pin_and_retire_have_one_final_owner() {
+        loom::model(|| {
+            use loom::sync::{
+                Arc,
+                atomic::{AtomicUsize, Ordering},
+            };
+            let state = Arc::new(AtomicUsize::new(RESIDENT | 1));
+            let drops = Arc::new(AtomicUsize::new(0));
+            let reader_state = Arc::clone(&state);
+            let reader_drops = Arc::clone(&drops);
+            let reader = loom::thread::spawn(move || {
+                // The unchanged read-domain protects pointer observation;
+                // this model checks only the replacement node state machine.
+                if reader_state
+                    .fetch_update(Ordering::AcqRel, Ordering::Acquire, |s| {
+                        (s & RESIDENT != 0 && s & PIN_COUNT != PIN_COUNT).then(|| s + 1)
+                    })
+                    .is_ok()
+                {
+                    assert_eq!(reader_drops.load(Ordering::Acquire), 0);
+                    if reader_state.fetch_sub(1, Ordering::AcqRel) == 1 {
+                        assert_eq!(reader_drops.fetch_add(1, Ordering::AcqRel), 0);
+                    }
+                }
+            });
+            if state.fetch_sub(RESIDENT + 1, Ordering::AcqRel) == RESIDENT + 1 {
+                assert_eq!(drops.fetch_add(1, Ordering::AcqRel), 0);
+            }
+            reader.join().unwrap();
+            assert_eq!(state.load(Ordering::Acquire), 0);
+            assert_eq!(drops.load(Ordering::Acquire), 1);
+        });
+    }

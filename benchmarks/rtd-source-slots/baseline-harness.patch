diff --git a/crates/xlfn/src/benchmark_support/rtd.rs b/crates/xlfn/src/benchmark_support/rtd.rs
--- a/crates/xlfn/src/benchmark_support/rtd.rs
+++ b/crates/xlfn/src/benchmark_support/rtd.rs
@@ -2,6 +2,126 @@
 use std::{cell::Cell, time::Instant};
 
 use crate::subscription::TOPIC_SHARDS;
+
+struct InlineBenchmarkSubscription(u64);
+
+// SAFETY: the subscription retains no sink and starts no background activity.
+unsafe impl crate::subscription::RtdSubscription for InlineBenchmarkSubscription {
+    fn request_cancel(&self) {
+        std::hint::black_box(self.0);
+    }
+
+    fn disconnect_and_wait(self: Box<Self>) -> crate::XllResult<()> {
+        std::hint::black_box(self.0);
+        Ok(())
+    }
+}
+
+struct InlineBenchmarkSource;
+
+// SAFETY: subscribe discards its sink immediately and the source owns no workers.
+unsafe impl crate::subscription::RtdSource for InlineBenchmarkSource {
+    type Value = i32;
+    type Subscription = InlineBenchmarkSubscription;
+
+    fn subscribe(
+        &self,
+        _topic: &crate::subscription::RtdTopic,
+        _sink: crate::subscription::RtdSink<Self::Value>,
+    ) -> crate::XllResult<Self::Subscription> {
+        Ok(InlineBenchmarkSubscription(1))
+    }
+}
+
+/// Runs a measurement with fixture construction, preparation and driver storage
+/// outside its scope. Every invocation connects `count` subscriptions before
+/// disconnecting any of them, so it exercises the source's live high-water mark.
+///
+/// Adapter mode uses the actual registered-source adapter with a nonallocating,
+/// nonzero-sized subscription. Runtime mode additionally includes connection
+/// publication, catalog transitions and synchronous server disconnection. An
+/// outstanding preparation guard preserves each canonical topic between runs.
+/// `warm` recycles a complete batch before passing the operation to `measure`.
+pub fn with_rtd_connection_benchmark<R>(
+    count: usize,
+    adapter_only: bool,
+    warm: bool,
+    measure: impl FnOnce(&mut dyn FnMut()) -> R,
+) -> R {
+    use crate::subscription::SubscriptionHost;
+
+    assert!((1..=4096).contains(&count));
+    assert_ne!(std::mem::size_of::<InlineBenchmarkSubscription>(), 0);
+    let generation = crate::generation::RuntimeGeneration::new(1).unwrap();
+    let registration = crate::subscription::SourceRegistration::new(generation);
+    let source_handle = registration.register(InlineBenchmarkSource).unwrap();
+    let runtime = Box::new(
+        crate::subscription::SubscriptionRuntime::with_sources_for_internal(registration.finish()),
+    );
+    // SAFETY: the boxed runtime stays at a stable address and is reclaimed only
+    // after the callback, all subscriptions and the server handle are dropped.
+    let server_handle = unsafe {
+        runtime
+            .register_server(crate::subscription::ServerGeneration::new(1).unwrap())
+            .unwrap()
+    };
+    let topics: Vec<_> = (0..count)
+        .map(|index| crate::subscription::RtdTopic::single(format!("connection-{index}")).unwrap())
+        .collect();
+
+    if adapter_only {
+        let source = runtime.sources.resolve(source_handle.id).unwrap();
+        let server = runtime
+            .resolve_server(crate::subscription::ServerGeneration::new(1).unwrap())
+            .unwrap();
+        let sink = crate::excel_rtd::RtdSubscriptionHost::publish_sink(
+            server.publish.as_ref(),
+            crate::subscription::TopicId(1),
+            crate::generation::ConnectionGeneration::new(1).unwrap(),
+        );
+        let mut subscriptions = Vec::with_capacity(count);
+        let mut operation = || {
+            for topic in &topics {
+                subscriptions.push(source.subscribe(topic, sink).unwrap());
+            }
+            for subscription in subscriptions.drain(..) {
+                subscription.request_cancel();
+                subscription.disconnect_and_wait().unwrap();
+            }
+        };
+        if warm {
+            operation();
+        }
+        measure(&mut operation)
+    } else {
+        let prepared: Vec<_> = topics
+            .iter()
+            .map(|topic| runtime.prepare(&source_handle, topic.borrowed()).unwrap())
+            .collect();
+        let mut operation = || {
+            for (index, prepared) in prepared.iter().enumerate() {
+                runtime
+                    .connect_transaction(
+                        &server_handle,
+                        crate::subscription::TopicId(index as i32 + 1),
+                        prepared.id(),
+                    )
+                    .unwrap()
+                    .commit()
+                    .unwrap();
+            }
+            for index in 0..count {
+                server_handle
+                    .disconnect(crate::subscription::TopicId(index as i32 + 1))
+                    .unwrap();
+            }
+        };
+        if warm {
+            operation();
+        }
+        measure(&mut operation)
+    }
+}
 
 struct BenchmarkSubscription;
 
diff --git a/crates/xlfn/benches/rtd_connection.rs b/crates/xlfn/benches/rtd_connection.rs
new file mode 100644
--- /dev/null
+++ b/crates/xlfn/benches/rtd_connection.rs
@@ -0,0 +1,22 @@
+use criterion::{BenchmarkId, Criterion, Throughput, criterion_group, criterion_main};
+use xlfn::benchmark_support::{benchmark_measurement_time, with_rtd_connection_benchmark};
+
+fn rtd_connection_benchmarks(c: &mut Criterion) {
+    let mut group = c.benchmark_group("rtd_connection");
+    group.measurement_time(benchmark_measurement_time());
+    for count in [1, 32, 256] {
+        group.throughput(Throughput::Elements(count as u64));
+        for adapter_only in [true, false] {
+            let case = if adapter_only { "adapter" } else { "runtime" };
+            group.bench_function(BenchmarkId::new(case, count), |b| {
+                with_rtd_connection_benchmark(count, adapter_only, true, |operation| {
+                    b.iter(operation);
+                });
+            });
+        }
+    }
+    group.finish();
+}
+
+criterion_group!(benches, rtd_connection_benchmarks);
+criterion_main!(benches);
diff --git a/crates/xlfn/benches/rtd_connection_allocations.rs b/crates/xlfn/benches/rtd_connection_allocations.rs
new file mode 100644
--- /dev/null
+++ b/crates/xlfn/benches/rtd_connection_allocations.rs
@@ -0,0 +1,116 @@
+//! Allocation gate for the production source adapter and full connection path.
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use xlfn::benchmark_support::with_rtd_connection_benchmark;
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+static ALLOCS: AtomicUsize = AtomicUsize::new(0);
+static REALLOCS: AtomicUsize = AtomicUsize::new(0);
+static BYTES: AtomicUsize = AtomicUsize::new(0);
+static RELEASED_BYTES: AtomicUsize = AtomicUsize::new(0);
+
+struct CountingAllocator;
+// SAFETY: all pointers and layouts are forwarded unchanged to System.
+unsafe impl GlobalAlloc for CountingAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        if ENABLED.load(Ordering::Relaxed) {
+            ALLOCS.fetch_add(1, Ordering::Relaxed);
+            BYTES.fetch_add(layout.size(), Ordering::Relaxed);
+        }
+        // SAFETY: the allocator contract supplies a valid layout.
+        unsafe { System.alloc(layout) }
+    }
+
+    unsafe fn dealloc(&self, pointer: *mut u8, layout: Layout) {
+        if ENABLED.load(Ordering::Relaxed) {
+            RELEASED_BYTES.fetch_add(layout.size(), Ordering::Relaxed);
+        }
+        // SAFETY: the pointer and layout came from the delegated allocator.
+        unsafe { System.dealloc(pointer, layout) }
+    }
+
+    unsafe fn realloc(&self, pointer: *mut u8, layout: Layout, size: usize) -> *mut u8 {
+        if ENABLED.load(Ordering::Relaxed) {
+            REALLOCS.fetch_add(1, Ordering::Relaxed);
+            BYTES.fetch_add(size, Ordering::Relaxed);
+            RELEASED_BYTES.fetch_add(layout.size(), Ordering::Relaxed);
+        }
+        // SAFETY: the caller supplies a live allocation and valid new size.
+        unsafe { System.realloc(pointer, layout, size) }
+    }
+}
+
+#[global_allocator]
+static ALLOCATOR: CountingAllocator = CountingAllocator;
+
+fn begin_counting() {
+    ALLOCS.store(0, Ordering::Relaxed);
+    REALLOCS.store(0, Ordering::Relaxed);
+    BYTES.store(0, Ordering::Relaxed);
+    RELEASED_BYTES.store(0, Ordering::Relaxed);
+    ENABLED.store(true, Ordering::Relaxed);
+}
+
+fn retained_bytes_delta() -> i128 {
+    BYTES.load(Ordering::Relaxed) as i128 - RELEASED_BYTES.load(Ordering::Relaxed) as i128
+}
+
+fn main() {
+    let report_only = std::env::var_os("XLFN_BENCH_REPORT_ONLY").is_some();
+    for count in [1, 32, 256] {
+        // Warm process/TLS infrastructure before measuring complete ownership.
+        with_rtd_connection_benchmark(count, true, false, |operation| operation());
+        begin_counting();
+        with_rtd_connection_benchmark(count, true, false, |operation| operation());
+        ENABLED.store(false, Ordering::Relaxed);
+        println!(
+            "{}",
+            serde_json::json!({
+                "case": "adapter_owner_lifecycle",
+                "subscriptions": count,
+                "process_allocations": ALLOCS.load(Ordering::Relaxed),
+                "process_reallocations": REALLOCS.load(Ordering::Relaxed),
+                "process_requested_bytes": BYTES.load(Ordering::Relaxed),
+                "process_retained_bytes_delta": retained_bytes_delta(),
+                "report_only": report_only,
+            })
+        );
+        if !report_only {
+            assert_eq!(
+                retained_bytes_delta(),
+                0,
+                "source teardown must reclaim every slot"
+            );
+        }
+        for adapter_only in [true, false] {
+            for warm in [false, true] {
+                with_rtd_connection_benchmark(count, adapter_only, warm, |operation| {
+                    begin_counting();
+                    operation();
+                    ENABLED.store(false, Ordering::Relaxed);
+                    let allocations = ALLOCS.load(Ordering::Relaxed);
+                    let reallocations = REALLOCS.load(Ordering::Relaxed);
+                    println!(
+                        "{}",
+                        serde_json::json!({
+                            "case": if adapter_only { "adapter" } else { "runtime" },
+                            "subscriptions": count,
+                            "warm": warm,
+                            "process_allocations": allocations,
+                            "process_reallocations": reallocations,
+                            "process_requested_bytes": BYTES.load(Ordering::Relaxed),
+                            "process_retained_bytes_delta": retained_bytes_delta(),
+                            "report_only": report_only,
+                        })
+                    );
+                    if warm && !report_only {
+                        // Runtime connection takes one owned canonical-topic
+                        // snapshot per connection; source storage adds none.
+                        assert_eq!(allocations, if adapter_only { 0 } else { count });
+                        assert_eq!(reallocations, 0);
+                    }
+                });
+            }
+        }
+    }
+}

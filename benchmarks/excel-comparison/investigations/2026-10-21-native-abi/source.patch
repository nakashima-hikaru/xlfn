diff --git a/crates/xlfn/src/benchmark_support/native_ingress.rs b/crates/xlfn/src/benchmark_support/native_ingress.rs
new file mode 100644
index 0000000..1621e23
--- /dev/null
+++ b/crates/xlfn/src/benchmark_support/native_ingress.rs
@@ -0,0 +1,148 @@
+//! Paired Q/native input conversion with identical call and identity setup.
+
+use super::{BenchmarkAddin, benchmark_ingress, get_benchmark_runtime};
+use crate::value::{ArgumentContext, FormulaInputMode, PlainInputMode, XlValueRef};
+
+enum Input {
+    Numbers,
+    Boolean,
+    Integer,
+    Text,
+}
+
+/// Compares native argument admission with strict XLOPER12 admission.
+/// Excel's preprocessing and generated-wrapper dispatch are outside this probe.
+pub struct NativeArgumentIngressBenchmark {
+    runtime: &'static crate::runtime::Runtime<BenchmarkAddin>,
+    input: Input,
+    raw: Vec<xlfn_sys::XLOPER12>,
+    text: Vec<u16>,
+}
+
+impl NativeArgumentIngressBenchmark {
+    pub fn numbers(count: usize) -> Self {
+        assert!([1, 2, 4, 8].contains(&count));
+        Self {
+            runtime: get_benchmark_runtime(),
+            input: Input::Numbers,
+            raw: (0..count)
+                .map(|index| xlfn_sys::XLOPER12::number(index as f64 + 0.5))
+                .collect(),
+            text: Vec::new(),
+        }
+    }
+
+    pub fn boolean() -> Self {
+        Self {
+            runtime: get_benchmark_runtime(),
+            input: Input::Boolean,
+            raw: vec![xlfn_sys::XLOPER12::boolean(true)],
+            text: Vec::new(),
+        }
+    }
+
+    pub fn integer() -> Self {
+        Self {
+            runtime: get_benchmark_runtime(),
+            input: Input::Integer,
+            raw: vec![xlfn_sys::XLOPER12::integer(i32::MAX)],
+            text: Vec::new(),
+        }
+    }
+
+    pub fn string(value: &str) -> Self {
+        let text: Vec<_> = std::iter::once(u16::try_from(value.encode_utf16().count()).unwrap())
+            .chain(value.encode_utf16())
+            .collect();
+        assert!(text.len() <= xlfn_common::EXCEL_STRING_LIMIT + 1);
+        Self {
+            runtime: get_benchmark_runtime(),
+            input: Input::Text,
+            raw: vec![xlfn_sys::XLOPER12::nil()],
+            text,
+        }
+    }
+
+    /// Runs one call. `identity` models a handle producer; `materialize=false`
+    /// models its warm input phase, after complete validation and hashing.
+    pub fn run(&mut self, native: bool, identity: bool, materialize: bool) {
+        if matches!(self.input, Input::Text) {
+            self.raw[0] = xlfn_sys::XLOPER12 {
+                value: xlfn_sys::XLOPER12Value {
+                    string: self.text.as_mut_ptr(),
+                },
+                xltype: xlfn_sys::XLTYPE_STR,
+            };
+        }
+        let ingress = benchmark_ingress();
+        let call = self
+            .runtime
+            .enter(&ingress)
+            .expect("benchmark runtime must be open");
+        crate::call::with_excel_call_scope_and_call(&call, |call, scope| {
+            macro_rules! run {
+                ($mode:ty) => {{
+                    let mut arguments = ArgumentContext::<$mode>::new(call, scope, self.raw.len());
+                    for (index, raw) in self.raw.iter_mut().enumerate() {
+                        macro_rules! prepare_q {
+                            ($ty:ty) => {{
+                                // SAFETY: fixture-owned payloads remain live and immutable during this call.
+                                let value = unsafe { XlValueRef::from_raw(raw) }.unwrap();
+                                arguments.prepare::<$ty>(index, "arg", value).unwrap()
+                            }};
+                        }
+                        match self.input {
+                            Input::Numbers => {
+                                let prepared = if native {
+                                    // SAFETY: the Numbers constructor initializes the numeric union field.
+                                    let number = unsafe { raw.value.number };
+                                    arguments.native_f64(index, "arg", std::hint::black_box(number)).unwrap()
+                                } else {
+                                    prepare_q!(f64).materialize().unwrap()
+                                };
+                                std::hint::black_box(prepared);
+                            }
+                            Input::Boolean => {
+                                let prepared = if native {
+                                    arguments.native_bool(index, "arg", std::hint::black_box(1)).unwrap()
+                                } else {
+                                    prepare_q!(bool).materialize().unwrap()
+                                };
+                                std::hint::black_box(prepared);
+                            }
+                            Input::Integer => {
+                                let prepared = if native {
+                                    arguments.native_i32(index, "arg", std::hint::black_box(i32::MAX)).unwrap()
+                                } else {
+                                    prepare_q!(i32).materialize().unwrap()
+                                };
+                                std::hint::black_box(prepared);
+                            }
+                            Input::Text => {
+                                fn consume<T, P>(prepared: crate::__private::v1::PreparedArgument<T, P>, materialize: bool) {
+                                    if materialize {
+                                        std::hint::black_box(prepared.materialize().unwrap());
+                                    } else {
+                                        std::hint::black_box(prepared);
+                                    }
+                                }
+                                if native {
+                                    // SAFETY: text owns a valid counted UTF-16 buffer for this call.
+                                    consume(unsafe { arguments.prepare_native_string(index, "arg", std::hint::black_box(self.text.as_ptr())) }.unwrap(), materialize);
+                                } else {
+                                    consume(prepare_q!(String), materialize);
+                                }
+                            }
+                        }
+                    }
+                    std::hint::black_box(arguments.finish().unwrap());
+                }};
+            }
+            if identity {
+                run!(FormulaInputMode);
+            } else {
+                run!(PlainInputMode);
+            }
+        });
+    }
+}
diff --git a/crates/xlfn/tests/ui/pass/native_abi.rs b/crates/xlfn/tests/ui/pass/native_abi.rs
new file mode 100644
index 0000000..eae55d8
--- /dev/null
+++ b/crates/xlfn/tests/ui/pass/native_abi.rs
@@ -0,0 +1,68 @@
+use xlfn::prelude::*;
+
+#[excel_addin(name = "Native ABI", id = "native-abi", category = "Test")]
+struct TestAddin;
+
+impl Addin for TestAddin {
+    type SharedState = ();
+    type LifecycleState = ();
+    type Error = XllError;
+    type Layers = ();
+    #[cfg(feature = "async")]
+    type AsyncExecutor = xlfn::NoAsyncExecutor;
+
+    fn open(_: &OpenContext) -> OpenResult<Self> {
+        Ok(Opened::new(()))
+    }
+}
+
+#[excel_function(thread_safe)]
+fn native(number: f64, enabled: bool, count: i32, text: String, borrowed: &str) -> f64 {
+    number + f64::from(count) + if enabled { (text.len() + borrowed.len()) as f64 } else { 0.0 }
+}
+
+#[excel_function]
+fn strict(
+    #[excel_arg(strict)] number: f64,
+    #[excel_arg(strict)] enabled: bool,
+    #[excel_arg(strict)] count: i32,
+    #[excel_arg(strict)] text: String,
+    #[excel_arg(strict)] borrowed: &str,
+) -> f64 {
+    native(number, enabled, count, text, borrowed)
+}
+
+#[excel_function]
+fn presence(
+    #[excel_arg(default = 1.0)] number: f64,
+    #[excel_arg(blank = convert)] enabled: bool,
+    #[excel_arg(missing = error)] count: i32,
+    #[excel_arg(missing = "convert")] text: String,
+) -> f64 {
+    number + f64::from(count) + if enabled { text.len() as f64 } else { 0.0 }
+}
+
+type NumberAlias = f64;
+
+#[excel_function]
+fn fallback(number: NumberAlias, count: i64, optional: Option<f64>) -> f64 {
+    number + count as f64 + optional.unwrap_or_default()
+}
+
+macro_rules! forward_type {
+    ($ty:ty) => {
+        #[excel_function]
+        fn forwarded(number: $ty) -> f64 { number }
+    };
+}
+forward_type!(::core::primitive::f64);
+
+fn main() {
+    use xlfn::__private::v1::XLOPER12;
+    type Value = *mut XLOPER12;
+    let _: unsafe extern "system" fn(f64, i16, i32, *const u16, *const u16) -> Value = xll_native;
+    let _: unsafe extern "system" fn(Value, Value, Value, Value, Value) -> Value = xll_strict;
+    let _: unsafe extern "system" fn(Value, Value, Value, Value) -> Value = xll_presence;
+    let _: unsafe extern "system" fn(Value, Value, Value) -> Value = xll_fallback;
+    let _: unsafe extern "system" fn(f64) -> Value = xll_forwarded;
+}
diff --git a/crates/xlfn/tests/ui/pass_async/native_abi.rs b/crates/xlfn/tests/ui/pass_async/native_abi.rs
new file mode 100644
index 0000000..1284f1c
--- /dev/null
+++ b/crates/xlfn/tests/ui/pass_async/native_abi.rs
@@ -0,0 +1,46 @@
+use xlfn::prelude::*;
+
+#[excel_addin(name = "Native ABI", id = "native-abi-async", category = "Test")]
+struct TestAddin;
+
+impl Addin for TestAddin {
+    type SharedState = ();
+    type LifecycleState = ();
+    type Error = XllError;
+    type Layers = ();
+    #[cfg(feature = "async")]
+    type AsyncExecutor = xlfn::NoAsyncExecutor;
+
+    fn open(_: &OpenContext) -> OpenResult<Self> {
+        Ok(Opened::new(()))
+    }
+}
+
+#[excel_function]
+async fn native(number: f64, enabled: bool, count: i32, text: String) -> f64 {
+    std::future::ready(()).await;
+    number + f64::from(count) + if enabled { text.len() as f64 } else { 0.0 }
+}
+
+#[excel_function]
+async fn strict(
+    #[excel_arg(strict)] number: f64,
+    #[excel_arg(strict)] enabled: bool,
+    #[excel_arg(strict)] count: i32,
+    #[excel_arg(strict)] text: String,
+) -> f64 {
+    native(number, enabled, count, text).await
+}
+
+#[excel_function]
+async fn presence(#[excel_arg(default = 1.0)] number: f64) -> f64 {
+    number
+}
+
+fn main() {
+    use xlfn::__private::v1::XLOPER12;
+    type Value = *mut XLOPER12;
+    let _: unsafe extern "system" fn(f64, i16, i32, *const u16, Value) = xll_native;
+    let _: unsafe extern "system" fn(Value, Value, Value, Value, Value) = xll_strict;
+    let _: unsafe extern "system" fn(Value, Value) = xll_presence;
+}
